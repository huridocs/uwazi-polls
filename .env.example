# Local Uwazi (default). CI writes its own env after seeding.
POLL_BASE_URL=http://localhost:3000
POLL_USERNAME=admin
POLL_PASSWORD=change this password now

# Filled after seed-pages (or set manually if pages already exist)
POLL_ADMIN_PATH=/en/page/<admin-sharedId>/poll-admin
POLL_PLAYER_PATH=/en/page/<player-sharedId>/poll-player
