{
  "name": "uwazi-polls",
  "private": true,
  "description": "Uwazi Pages poll admin/player + Playwright regression tests",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "seed:schema": "node scripts/seed-poll-schema.mjs",
    "seed:pages": "node scripts/seed-pages.mjs",
    "seed": "yarn seed:schema && yarn seed:pages",
    "ci:up": "bash scripts/ci-up.sh",
    "ci:down": "bash scripts/ci-down.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
